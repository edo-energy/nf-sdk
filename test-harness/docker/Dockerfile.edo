FROM mcktechsolutions.azurecr.io/devicecontrol:latest

# Install libfaketime for time acceleration
RUN apt-get update && \
    apt-get install -y --no-install-recommends libfaketime && \
    rm -rf /var/lib/apt/lists/*

# Configure libfaketime
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1
ENV FAKETIME_TIMESTAMP_FILE=/faketime/offset
ENV FAKETIME_NO_CACHE=1

# Create faketime directory
RUN mkdir -p /faketime && echo "+0" > /faketime/offset
